# ~/.agents/.env.sample — copy to ~/.agents/.env and fill in real values.
#
# ~/.agents/.env is gitignored; it is the non-interactive fallback for shells
# NOT launched from a login zsh (cron jobs, daemons, fresh subshells). In a
# normal interactive session the real values are sourced from ~/.zsh_secrets
# (via ~/.zshrc) and inherited as env vars, so this file is optional.

# ── ClickUp ──────────────────────────────────────────────────────────────────
# CLICKUP_API_KEY is canonical — the clickup MCP server requires this exact name,
# and the REST scripts fall back to it. Keep ONE var: this one.
CLICKUP_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLICKUP_TEAM_ID=5747865

# Optional/legacy: REST scripts read CLICKUP_API_TOKEN first, then fall back to
# CLICKUP_API_KEY. If KEY above is set, you do NOT need this duplicate.
# CLICKUP_API_TOKEN=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Premium third-party MCP servers only (e.g. @taazkareem/clickup-mcp-server):
# CLICKUP_MCP_LICENSE_KEY=

# ── Figma ────────────────────────────────────────────────────────────────────
# NOT read from this file. The native figma_* tools use a token at
# ~/.pi/figma/config.json (verify with the figma_auth_status tool). A Framelink
# Figma MCP server (figd_... key) may instead live in ~/.claude.json.

# ── GitLab (glab CLI) ────────────────────────────────────────────────────────
# NOT configured here. Authenticate the glab CLI once:
#   glab auth login
# mr-review / gitlab-actions shell out to `glab api`, which reads its own
# config-stored token. Do NOT export GITLAB_ACCESS_TOKEN — a stale value there
# overrides glab's config and breaks auth. If it leaks in, prefix commands with
# `env -u GITLAB_ACCESS_TOKEN`.
